# Telemetria da antena (opcional). Copie para .env e preencha só o que você usa.
# As chaves ficam AQUI, no seu computador — nunca no navegador.

# OpenTelemetry genérico (Collector, Grafana, Honeycomb, Jaeger…)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=SUA_CHAVE

# Datadog — via OTLP do Datadog Agent (otlp_config.receiver.protocols.http habilitado)
# DD_OTLP_ENDPOINT=http://localhost:4318

# New Relic — OTLP nativo (licença "INGEST - LICENSE")
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net

# Sentry — erros do navegador e da antena
# SENTRY_DSN=https://CHAVE@o000000.ingest.sentry.io/0000000

# Base de conhecimento: pasta de notas .md (ex.: vault do Obsidian). Padrão: ./knowledge
# DOCS_DIR=../minhas-notas

# Porta da antena (padrão 4242; a hospedagem usa PORT)
# AURORA_PORT=4242

# Modo hospedado: escutar fora do seu PC exige senha (12+ caracteres)
# AURORA_HOST=0.0.0.0
# AURORA_PASSWORD=
